# Finance Tracker Environment Configuration

# Application Server Port (Render injects PORT automatically)
PORT=8080

# Active Spring Profile (use 'dev' for local H2 file storage; 'prod' for Render PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Production PostgreSQL Database Configuration
# NOTE: Render gives you an External/Internal connection string starting with 'postgres://':
#   e.g.: postgres://finsight_user:secretpass123@dpg-abc12345-a.oregon-postgres.render.com/finsight_db
#
# Convert it to JDBC format:
#   DATABASE_URL=jdbc:postgresql://dpg-abc12345-a.oregon-postgres.render.com:5432/finsight_db
#   DB_USERNAME=finsight_user
#   DB_PASSWORD=secretpass123
DATABASE_URL=jdbc:postgresql://localhost:5432/financetracker
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# Or standard Spring Boot datasource format:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/financetracker
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password

# Legacy account claim email (registration with this email claims pre-existing legacy data)
LEGACY_OWNER_EMAIL=aswin@example.com
